# FinTrack Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/fintrack

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_at_least_32_random_characters
REFRESH_TOKEN_SECRET=replace_with_different_32_random_characters

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256 Plaid token encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_char_hex_string

# ─── Plaid ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox                          # sandbox | development | production
PLAID_WEBHOOK_SECRET=your_plaid_webhook_secret

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend (Vite — must be prefixed with VITE_) ───────────────────────────
VITE_API_BASE_URL=http://localhost:3001
